# Keep the ModelScope token private and server-side.
QWEN_API_KEY=
QWEN_BASE_URL=https://api-inference.modelscope.ai/v1
QWEN_MODEL=Qwen-Ambassador/Qwen3.8-Max

# Create a Miro app with boards:read and boards:write scopes.
MIRO_CLIENT_ID=
MIRO_CLIENT_SECRET=
# Optional direct Miro OAuth access token for a single local user.
MIRO_ACCESS_TOKEN=
MIRO_REDIRECT_URI=http://localhost:4173/api/miro/callback
APP_ORIGIN=http://localhost:4173
